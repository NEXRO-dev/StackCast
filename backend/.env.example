TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# 本番ではopenssl rand -base64 48などで生成した十分に長い値を設定してください。
AUTH_OTP_SECRET=replace-with-a-long-random-secret

# Resendで確認済みの送信元ドメインを使用します。
RESEND_API_KEY=re_your_api_key
AUTH_EMAIL_FROM=StashCast <no-reply@auth.example.com>

# Google Cloud Consoleで作成したWeb application用Client IDです。
GOOGLE_SERVER_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# iOSネイティブアプリではBundle IDを指定します。
APPLE_CLIENT_ID=com.nexro.Tsundoku
